{
  "name": "sky-islands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sky Islands \u2014 landscape arcade game wrapped as a native iOS app with Capacitor",
  "scripts": {
    "sync": "cap sync ios && node scripts/patch-capacitor-spm.mjs",
    "open": "cap open ios",
    "assets": "capacitor-assets generate --ios --iconBackgroundColor '#12356b' --splashBackgroundColor '#12356b'",
    "serve": "npx --yes serve www -l 8080"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "typescript": "^7.0.2"
  }
}
